# 复制到 /etc/nginx/conf.d/codemux-relay.conf 或宝塔「站点 → 反向代理」
# 前提: relay.fumi-blog.top A 记录指向本机公网 IP；certbot 已签发证书

server {
    listen 80;
    server_name relay.fumi-blog.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name relay.fumi-blog.top;

    ssl_certificate     /etc/letsencrypt/live/relay.fumi-blog.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.fumi-blog.top/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
