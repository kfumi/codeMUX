{
  "name": "@codemux/desktop",
  "version": "0.4.1",
  "private": true,
  "description": "CodeMUX",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "pack:win": "npm run build && node scripts/copy-renderer-dist.mjs && node scripts/copy-sidecar-dist.mjs && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "electron": "^33.2.0",
    "electron-builder": "26.16.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3"
  }
}
