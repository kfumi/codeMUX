# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
# 统一前端产物(工单 02):npm run build:web 产出,daemon 直接服务浏览器/移动形态
dist-web
# Monaco 的 AMD 运行时(vendor 产物,约 24MB):由 scripts/vendor-monaco.mjs 从
# node_modules/monaco-editor/min/vs 拷入,带版本戳,不要进 git。
public/vs
dist-electron
# Electron 打包产物(工单 06):renderer-dist 由 scripts/copy-renderer-dist.mjs
# 在打包前从根 dist/ 拷入;release/ 为 electron-builder 输出。
apps/desktop/renderer-dist
apps/desktop/sidecar-dist
apps/desktop/release
# 打包前由 scripts/stage-daemon-bin.mjs 生成:按当前平台放 codemux-daemon[.exe],
# 供 electron-builder 的 extraResources(from: daemon-bin)收进资源根。
apps/desktop/daemon-bin
# CI 出包时在 apps/desktop/ 下产生的中间物(packaging.log 是打包日志,
# release-assets 是收集后的待上传产物目录)。
apps/desktop/packaging.log
release-assets/
dist-ssr
.worktrees/
*.local


# 根目录出现这些只可能是误操作(本地演练脚本曾把 Copy-Item 的目标写成空,
# PowerShell 会默认复制到当前目录)。它们是 100MB+ 的构建产物,绝不该进仓库。
/latest.yml
/*.exe
/*.blockmap
# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust daemon
crates/daemon/target/
crates/daemon/config.json

# custom
out/
.superpowers/
log/
.pi/
*.zip

# TypeScript 增量构建产物
*.tsbuildinfo
