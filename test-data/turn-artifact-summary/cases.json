        { "type": "tool_finished", "tool_use_id": "patch-2", "is_error": false }
      ],
      "expectedDiffs": [
        { "file": "D:/project/demo/README.md", "before": "old", "after": "new", "additions": 1, "deletions": 1 }
      ]
