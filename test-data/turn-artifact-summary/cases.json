      "name": "reverted-file-dropped-but-real-change-kept",
      "cwd": "D:/project/demo",
      "events": [
        { "type": "file_snapshot", "file_path": "D:/project/demo/src/revert.ts", "original_content": "orig\n", "is_new": false, "tool_use_id": "both-1" },
        { "type": "tool_started", "tool_use_id": "both-1", "name": "write", "input": { "file_path": "src/revert.ts", "content": "changed\n" } },
        { "type": "tool_finished", "tool_use_id": "both-1", "is_error": false },
        { "type": "tool_started", "tool_use_id": "both-2", "name": "write", "input": { "file_path": "src/revert.ts", "content": "orig\n" } },
        { "type": "tool_finished", "tool_use_id": "both-2", "is_error": false },
