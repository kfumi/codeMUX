    {
      "$comment": "实时来源(OpenCode):工具名是补丁类,入参键为 patchText,补丁内是 Windows 绝对路径。",
      "name": "patch-opencode-patchtext-key-absolute-path",
      "cwd": "D:/project/demo",
      "events": [
        { "type": "tool_started", "tool_use_id": "patch-3", "name": "apply_patch", "input": { "patchText": "*** Begin Patch\n*** Update File: D:\\project\\demo\\src\\abs.ts\n@@\n-old line\n+new line\n*** End Patch" } },
        { "type": "tool_finished", "tool_use_id": "patch-3", "is_error": false }
      ],
      "expectedDiffs": [
        { "file": "D:/project/demo/src/abs.ts", "before": "old line", "after": "new line", "additions": 1, "deletions": 1 }
      ]
    },
    {
      "$comment": "补丁新增文件:没有变更前内容,全部计入增行。",
      "name": "patch-add-file",
      "cwd": "D:/project/demo",
      "events": [
        { "type": "tool_started", "tool_use_id": "patch-add", "name": "patch", "input": { "input": "*** Begin Patch\n*** Add File: docs/new.md\n+# Title\n+body\n*** End Patch" } },
        { "type": "tool_finished", "tool_use_id": "patch-add", "is_error": false }
      ],
      "expectedDiffs": [
        { "file": "D:/project/demo/docs/new.md", "after": "# Title\nbody", "additions": 2, "deletions": 0 }
      ]
    },
    {
      "$comment": "补丁删除文件:变更后为空,全部计入删行。",
      "name": "patch-delete-file",
      "cwd": "D:/project/demo",
      "events": [
        { "type": "tool_started", "tool_use_id": "patch-del", "name": "apply_patch", "input": { "input": "*** Begin Patch\n*** Delete File: docs/gone.md\n-# Title\n-body\n*** End Patch" } },
        { "type": "tool_finished", "tool_use_id": "patch-del", "is_error": false }
      ],
      "expectedDiffs": [
        { "file": "D:/project/demo/docs/gone.md", "before": "# Title\nbody", "additions": 0, "deletions": 2 }
      ]
    },
    {
      "$comment": "一段补丁触及多个文件:每个文件各产出一条条目。",
      "name": "patch-multiple-files",
      "cwd": "D:/project/demo",
      "events": [
        { "type": "tool_started", "tool_use_id": "patch-multi", "name": "apply_patch", "input": { "input": "*** Begin Patch\n*** Add File: a/one.txt\n+one\n*** Add File: b/two.txt\n+two\n*** End Patch" } },
        { "type": "tool_finished", "tool_use_id": "patch-multi", "is_error": false }
      ],
      "expectedDiffs": [
        { "file": "D:/project/demo/a/one.txt", "after": "one", "additions": 1, "deletions": 0 },
        { "file": "D:/project/demo/b/two.txt", "after": "two", "additions": 1, "deletions": 0 }
      ]
    },
    {
