        { "type": "tool_finished", "tool_use_id": "both-3", "is_error": false }
      ],
      "expectedDiffs": [
        { "file": "D:/project/demo/src/kept.ts", "before": "", "after": "kept\n", "additions": 1, "deletions": 0 }
