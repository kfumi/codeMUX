{
  "name": "codemux",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:renderer": "vite build",
    "build:web": "vite build --outDir dist-web --emptyOutDir",
    "build:daemon": "cd src-tauri && cargo build --bin codemux-daemon",
    "build:daemon:release": "cd src-tauri && cargo build --release --bin codemux-daemon",
    "build:electron": "cd desktop-electron && npm run build",
    "build:electron-installer": "npm run build:sidecar && npm run build:daemon:release && npm run build:renderer && npm run build:web && cd desktop-electron && npm run pack:win",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:electron": "cd desktop-electron && npm run dev",
    "build:sidecar": "cd src-tauri/sidecar && npm run build",
    "preview": "vite preview",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:ship": "node scripts/release-ship.mjs",
    "relay:configure": "node scripts/relay/configure-desktop.mjs",
    "relay:pack-vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/relay/pack-for-vps.ps1",
    "relay:pack-full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/relay/pack-full-deploy.ps1",
    "test": "vitest run",
    "test:sidecar": "cd src-tauri/sidecar && npm run test"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/react-lexical": "^0.2.4",
    "@assistant-ui/react-markdown": "^0.14.1",
    "@assistant-ui/react-streamdown": "^0.3.4",
    "@assistant-ui/store": "^0.2.20",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lexical/react": "^0.45.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-context-menu": "^2.3.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-symbols/icons": "^1.4.1",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "assistant-cloud": "^0.1.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "lexical": "^0.45.0",
    "lucide-react": "^0.460.0",
    "mnemonic-id": "^4.1.0",
    "parse-diff": "^0.12.0",
    "radix-ui": "^1.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
