{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@mobile/*": ["src/*"],
      "@shared/lib/agentPermissions": ["../src/lib/agentPermissions.ts"],
      "@shared/lib/companion-connection": ["../src/lib/companion-connection/index.ts"],
      "@shared/types/session": ["../src/types/session.ts"]
    }
  },
  "include": ["src"]
}
